{
  "name": "@particle-academy/fancy-chat-ui",
  "version": "0.1.0",
  "description": "React agent-chat surfaces composed from react-fancy: useAgentThread (resumable SSE with long-poll fallback over the neutral fancy-chat-js contract), AgentThread, AgentComposer, activity rows, ApprovalCard and QuestionForm. Controlled, stable data-fancy-chat-* handles, provider-neutral, no Prism import.",
  "keywords": [
    "agent",
    "chat",
    "react",
    "human-in-the-loop",
    "hitl",
    "human-plus",
    "fancy",
    "particle-academy"
  ],
  "homepage": "https://github.com/Particle-Academy/fancy-chat-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-chat-ui.git"
  },
  "bugs": "https://github.com/Particle-Academy/fancy-chat-ui/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "check:no-prism": "node node_modules/@particle-academy/fancy-chat-js/scripts/check-no-prism.mjs .",
    "sabotage": "node tests/sabotage.mjs",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@particle-academy/fancy-chat-js": ">=0.1.0 <2.0",
    "@particle-academy/react-fancy": ">=6.26.0 <7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@particle-academy/fancy-chat-js": "file:../fancy-chat-js",
    "@particle-academy/react-fancy": "file:../react-fancy",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2"
  }
}
