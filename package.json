{
  "name": "@particle-academy/fancy-chat-ui",
  "version": "0.3.0",
  "description": "React agent-chat surfaces on Prism, composed from react-fancy: useAgentThread (resumable SSE with long-poll fallback over the fancy-chat-js thread log that fancy-chat-php projects Prism Harness runs into), AgentThread, AgentComposer with attachments, activity rows, ApprovalCard and QuestionForm, and an optional knowledge explorer on prism-graph's types. Controlled, stable data-fancy-chat-* handles.",
  "keywords": [
    "agent",
    "chat",
    "react",
    "prism",
    "prism-harness",
    "human-in-the-loop",
    "hitl",
    "human-plus",
    "fancy",
    "particle-academy"
  ],
  "homepage": "https://github.com/Particle-Academy/fancy-chat-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-chat-ui.git"
  },
  "bugs": "https://github.com/Particle-Academy/fancy-chat-ui/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./knowledge": {
      "import": {
        "types": "./dist/knowledge.d.ts",
        "default": "./dist/knowledge.js"
      },
      "require": {
        "types": "./dist/knowledge.d.cts",
        "default": "./dist/knowledge.cjs"
      }
    },
    "./charts": {
      "import": {
        "types": "./dist/charts.d.ts",
        "default": "./dist/charts.js"
      },
      "require": {
        "types": "./dist/charts.d.cts",
        "default": "./dist/charts.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pretest": "tsup",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "tsc --noEmit && eslint .",
    "sabotage": "node tests/sabotage.mjs",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@particle-academy/fancy-chat-js": ">=0.1.0 <2.0",
    "@particle-academy/fancy-echarts": ">=6.3.0 <7",
    "@particle-academy/prism-graph": ">=0.3.0 <2.0",
    "@particle-academy/react-fancy": ">=6.28.0 <7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@particle-academy/fancy-echarts": {
      "optional": true
    },
    "@particle-academy/prism-graph": {
      "optional": true
    }
  },
  "devDependencies": {
    "@particle-academy/fancy-chat-js": "^0.2.0",
    "@particle-academy/fancy-echarts": "^6.3.0",
    "@particle-academy/prism-graph": "^0.3.0",
    "@particle-academy/react-fancy": "^6.28.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2"
  }
}
